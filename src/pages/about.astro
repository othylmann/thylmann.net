---
import BaseLayout from "../layouts/BaseLayout.astro";
import Timeline from "../components/Timeline.astro";
import Footer from "../components/Footer.astro";
import { aboutSchema, press, profiles } from "../data/person";

const title = "About Oliver Thylmann | Serial Entrepreneur, Co-Founder of Giant Swarm";
const description =
  "Oliver Thylmann is a German serial entrepreneur based in Cologne and co-founder of Giant Swarm. Previously co-founded Ormigo and adcloud, which was acquired by Deutsche Post DHL in 2011.";

const facts = [
  { label: "Based in", value: "Cologne, Germany" },
  { label: "Current", value: "Co-Founder & Co-CEO, Giant Swarm" },
  { label: "Board", value: "Governing Board, NeoNephos Foundation (Linux Foundation Europe)" },
  { label: "Podcast", value: "Co-host, Die Nerd Show (since 2020)" },
  { label: "Education", value: "Diplom in Physics, RWTH Aachen · MBA, Open University Business School" },
  { label: "Languages", value: "German, English, French" },
];

const links = [
  { label: "LinkedIn", href: profiles.linkedin },
  { label: "X / Twitter", href: profiles.x },
  { label: "Medium", href: profiles.medium },
  { label: "GitHub", href: profiles.github },
  { label: "Instagram", href: profiles.instagram },
  { label: "Giant Swarm blog", href: profiles.giantSwarmAuthor },
  { label: "Die Nerd Show", href: "https://dienerdshow.de/" },
];

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });
---

<BaseLayout title={title} description={description} schema={aboutSchema()} ogType="profile">
  <div class="layout-grid pt-10 md:pt-14 pb-20">
    <div class="px-6">
      <a href="/" class="text-accent font-mono text-sm hover:underline inline-block mb-10">&larr; Back home</a>

      <header class="grid gap-12 lg:grid-cols-[1.25fr_0.75fr] lg:gap-16 items-start animate-fade-in">
        <div>
          <p class="font-mono text-sm text-accent mb-5">About</p>
          <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold tracking-tight leading-[0.95] mb-10">
            Oliver Thylmann<span class="text-accent">.</span>
          </h1>

          <div class="space-y-6 max-w-[62ch] text-lg md:text-xl leading-relaxed text-text-muted">
            <p class="text-xl md:text-2xl leading-snug text-text-main">
              Oliver Thylmann is a German serial entrepreneur based in Cologne and co-founder of{" "}
              <a href="https://giantswarm.io" class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">Giant Swarm</a>, a
              Kubernetes platform company he started in 2014 with Henning Lange and Timo Derstappen.
            </p>
            <p>
              He studied physics at RWTH Aachen and co-founded his first company, the statistics service
              STATSnet, as a student in 1999. From 2003 to 2005 he worked on the performance advertising
              product at OnVista Media and later earned an MBA from the Open University Business School.
            </p>
            <p>
              Together with Henning Lange he co-founded Ormigo in 2005, a platform connecting local
              merchants with international traffic sources, which was sold to a Yellow Pages publisher in
              2010. Their next company, the performance advertising network adcloud, was acquired by
              Deutsche Post DHL in 2011, with both remaining as managing directors.
            </p>
            <p>
              At Giant Swarm, Oliver focuses on customers, people and culture. The company runs managed
              cloud-native platforms for enterprises across Europe. He serves on the{" "}
              <a href="https://neonephos.org/governing_board" class="text-text-main underline decoration-accent/40 underline-offset-4 hover:decoration-accent">Governing Board of the NeoNephos Foundation</a>,
              a Linux Foundation Europe project advancing open-source digital sovereignty, co-hosts the
              German tech podcast <em>Die Nerd Show</em>, and is active as an angel investor.
              In Cologne he is a member of the Cölner Club.
            </p>
          </div>
        </div>

        <figure class="relative mx-auto w-full max-w-[17rem] sm:max-w-sm lg:max-w-none lg:sticky lg:top-10 order-first lg:order-none mb-6 lg:mb-0">
          <div class="absolute -inset-3 rounded-[2rem] bg-brick/30 -rotate-2" aria-hidden="true"></div>
          <img
            src="/images/oliver-thylmann-portrait-1080x1350.jpg"
            alt="Oliver Thylmann"
            width="1080"
            height="1350"
            class="relative w-full aspect-[4/5] object-cover rounded-[1.75rem] shadow-2xl shadow-black/50"
          />
          <img
            src="/images/oliver-thylmann-formal.jpg"
            alt="Oliver Thylmann in black tie"
            width="1200"
            height="1600"
            loading="lazy"
            class="absolute -bottom-8 -left-6 w-28 sm:w-32 aspect-[3/4] object-cover rounded-2xl border-4 border-bg-base shadow-xl rotate-[-4deg]"
          />
        </figure>
      </header>

      <section class="mt-24">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-text-main flex items-center gap-4">
          <span class="text-accent text-sm font-mono">01.</span>
          At a glance
        </h2>
        <dl class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            facts.map((f) => (
              <div class="glass-card rounded-2xl p-5">
                <dt class="font-mono text-xs uppercase tracking-wider text-accent mb-2">{f.label}</dt>
                <dd class="text-text-main text-lg leading-snug">{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <div class="max-w-4xl">
        <Timeline index="02." title="The Journey" />
      </div>

      <section class="py-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-text-main flex items-center gap-4">
          <span class="text-accent text-sm font-mono">03.</span>
          In the press
        </h2>
        <ul class="grid gap-4 md:grid-cols-2">
          {
            press.map((p) => (
              <li>
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group glass-card rounded-2xl p-6 h-full flex flex-col justify-between gap-4 hover:border-accent/40 transition-colors"
                >
                  <p class="text-lg md:text-xl font-bold text-text-main group-hover:text-accent transition-colors leading-snug" lang={p.inLanguage}>
                    {p.headline}
                  </p>
                  <span class="font-mono text-xs text-text-muted">
                    {p.publisher} · {fmt(p.datePublished)} &nearr;
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="py-8">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-text-main flex items-center gap-4">
          <span class="text-accent text-sm font-mono">04.</span>
          Elsewhere
        </h2>
        <ul class="flex flex-wrap gap-3">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target="_blank"
                  rel="me noopener noreferrer"
                  class="inline-block px-5 py-2.5 border border-white/15 rounded-full text-text-main hover:border-accent hover:text-accent transition-colors"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
  <Footer />
</BaseLayout>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in { animation: fadeIn 0.7s ease-out both; }
  @media (prefers-reduced-motion: reduce) { .animate-fade-in { animation: none; } }
</style>
