---
import BaseLayout from "../layouts/BaseLayout.astro";
import Timeline from "../components/Timeline.astro";
import Footer from "../components/Footer.astro";
import { aboutSchema, press, profiles } from "../data/person";

const title = "About Oliver Thylmann | Serial Entrepreneur, Co-Founder of Giant Swarm";
const description =
  "Oliver Thylmann is a German serial entrepreneur based in Cologne and co-founder of Giant Swarm. Previously co-founded Ormigo and adcloud, which was acquired by Deutsche Post DHL in 2011.";

const facts = [
  { label: "Based in", value: "Cologne, Germany" },
  { label: "Current", value: "Co-Founder & Co-CEO, Giant Swarm" },
  { label: "Board", value: "Governing Board, NeoNephos Foundation" },
  { label: "Podcast", value: "Co-host, Die Nerd Show (since 2020)" },
  { label: "Education", value: "Diplom in Physics, RWTH Aachen · MBA, Open University Business School" },
  { label: "Languages", value: "German, English, French" },
];

const links = [
  { label: "LinkedIn", href: profiles.linkedin },
  { label: "X / Twitter", href: profiles.x },
  { label: "Medium", href: profiles.medium },
  { label: "GitHub", href: profiles.github },
  { label: "Giant Swarm blog", href: profiles.giantSwarmAuthor },
  { label: "Die Nerd Show", href: "https://dienerdshow.de/" },
];

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });
---

<BaseLayout title={title} description={description} schema={aboutSchema()} ogType="profile">
  <div class="layout-grid pt-20 pb-20">
    <div class="full-width md:col-start-2 md:col-end-3 px-6">
      <header class="mb-16 animate-fade-in">
        <a href="/" class="text-accent font-mono text-sm hover:underline mb-4 inline-block">← Back Home</a>
        <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-[0.95] mb-8">
          About Oliver<br />Thylmann<span class="text-accent">.</span>
        </h1>

        <div class="space-y-6 max-w-prose text-lg leading-relaxed text-text-muted">
          <p class="text-xl md:text-2xl text-text-main">
            Oliver Thylmann is a German serial entrepreneur based in Cologne and co-founder of{" "}
            <a href="https://giantswarm.io" class="text-accent hover:underline">Giant Swarm</a>, a
            Kubernetes platform company he started in 2014 with Henning Lange and Timo Derstappen.
          </p>
          <p>
            He studied physics at RWTH Aachen and co-founded his first company, the statistics service
            STATSnet, as a student in 1999. From 2003 to 2005 he worked on the performance advertising
            product at OnVista Media and later earned an MBA from the Open University Business School.
          </p>
          <p>
            Together with Henning Lange he co-founded Ormigo in 2005, a platform connecting local
            merchants with international traffic sources, which was sold to a Yellow Pages publisher in
            2010. Their next company, the performance advertising network adcloud, was acquired by
            Deutsche Post DHL in 2011, with both remaining as managing directors.
          </p>
          <p>
            At Giant Swarm, Oliver focuses on customers, people and culture. The company runs managed
            cloud-native platforms for enterprises across Europe. He serves on the Governing Board of the
            NeoNephos Foundation, which advances open-source digital sovereignty in Europe, co-hosts the
            German tech podcast <em>Die Nerd Show</em>, and invests as an angel in developer-tool startups.
          </p>
        </div>
      </header>

      <section class="mb-24">
        <h2 class="text-3xl font-bold mb-10 text-text-main flex items-center gap-4">
          <span class="text-accent text-sm font-mono">01.</span>
          At a glance
        </h2>
        <dl class="grid grid-cols-1 sm:grid-cols-[10rem_1fr] gap-x-8 gap-y-4 border-t border-white/10 pt-6">
          {
            facts.map((f) => (
              <>
                <dt class="font-mono text-xs uppercase tracking-wider text-accent/80 pt-1">{f.label}</dt>
                <dd class="text-text-main">{f.value}</dd>
              </>
            ))
          }
        </dl>
      </section>

      <Timeline index="02." title="The Journey" />

      <section class="py-20">
        <h2 class="text-3xl font-bold mb-10 text-text-main flex items-center gap-4">
          <span class="text-accent text-sm font-mono">03.</span>
          In the press
        </h2>
        <ul class="space-y-6">
          {
            press.map((p) => (
              <li class="glass-card rounded-2xl p-6 hover:border-accent/40 transition-colors">
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="group block">
                  <span class="font-mono text-xs text-accent">
                    {p.publisher} · {fmt(p.datePublished)}
                  </span>
                  <p class="text-lg font-bold text-text-main group-hover:text-accent transition-colors mt-1" lang={p.inLanguage}>
                    {p.headline}
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="py-10">
        <h2 class="text-3xl font-bold mb-10 text-text-main flex items-center gap-4">
          <span class="text-accent text-sm font-mono">04.</span>
          Elsewhere
        </h2>
        <ul class="flex flex-wrap gap-3">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target="_blank"
                  rel="me noopener noreferrer"
                  class="inline-block px-5 py-2 border border-accent/20 rounded-full text-accent hover:bg-accent/10 transition-colors"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
  <Footer />
</BaseLayout>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in { animation: fadeIn 0.8s ease-out forwards; }
</style>
