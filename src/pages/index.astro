---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import BentoGrid from '../components/BentoGrid.astro';
import Footer from '../components/Footer.astro';
import { homeSchema } from '../data/person';
---

<BaseLayout
	title="Oliver Thylmann | Serial Entrepreneur, Co-Founder of Giant Swarm"
	description="Oliver Thylmann is a Cologne-based serial entrepreneur and co-founder of Giant Swarm. Previously co-founded Ormigo and adcloud."
	schema={homeSchema()}
>
	<div class="layout-grid pt-6 md:pt-10">
		<div class="full-width md:col-start-2 md:col-end-3 px-6">
			<Hero />
			
      <BentoGrid />
		</div>
	</div>
  <Footer />
</BaseLayout>
