    <span class="text-accent text-sm font-mono">01.</span>
    The Network
  </h2>

  <!-- CSS Grid for Bento Layout -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 auto-rows-[200px]">
    <!-- MEDIUM (Standard Block) -->
    <a
      href="https://medium.com/@othylmann"
      target="_blank"
      rel="noopener noreferrer"
      class="bg-[#FAF9F6] rounded-2xl p-8 flex flex-col justify-between group hover:border-accent/50 transition-colors shadow-sm"
    >
      <div class="flex justify-between items-start">
        <span class="font-mono text-amber-700 text-xs">WRITING</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6 text-slate-400 group-hover:text-amber-600 transition-colors"
          fill="currentColor"
          viewBox="0 0 24 24"
