---
interface Props {
    text: string;
    author: string;
}

const { text, author } = Astro.props;
---

<figure
    class="relative max-w-sm rounded-2xl border border-white/10 bg-[#15181e]/95 backdrop-blur-md p-5 shadow-xl shadow-black/40"
>
    <span
        class="absolute -top-4 left-5 font-display text-5xl leading-none text-accent select-none"
        aria-hidden="true">&ldquo;</span
    >
    <p class="text-[11px] font-mono text-accent/80 uppercase tracking-[0.18em] mb-2">
        Quote of the day
    </p>
    <blockquote class="text-base md:text-lg text-text-main leading-snug italic">
        {text}
    </blockquote>
    <figcaption class="mt-3 flex items-center gap-2 text-sm text-text-muted">
        <span class="h-px w-5 bg-accent/50"></span>
        {author}
    </figcaption>
</figure>
